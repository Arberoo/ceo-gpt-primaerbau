<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Vorlage. Der Installer ersetzt __PYTHON__ und __WORKSPACE__ mit den echten
     Pfaden (z.B. per sed) und kopiert die Datei nach ~/Library/LaunchAgents/.
     Uhrzeit (Hour/Minute) bei Bedarf anpassen. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ceogpt.buchhaltung-reminder</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>__WORKSPACE__/scripts/buchhaltung_reminder.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__WORKSPACE__</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>9</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__WORKSPACE__/data/buchhaltung-reminder.log</string>
  <key>StandardErrorPath</key>
  <string>__WORKSPACE__/data/buchhaltung-reminder.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
